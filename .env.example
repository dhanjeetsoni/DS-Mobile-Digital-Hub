# Copy this file to plain .env before EVERY build (Windows, Staff Android,
# or Owner Android), filling in VITE_APP_VARIANT/VITE_APP_PLATFORM for
# whichever one you're building. Always use the name ".env" — never
# ".env.staff" or ".env.owner": the build command behind android:*:build /
# tauri:build is a plain `vite build` (no --mode flag), so Vite only ever
# loads .env / .env.local / .env.production / .env.production.local; a file
# named .env.staff or .env.owner is silently ignored, and the resulting app
# ships with no Supabase config and the wrong variant. If you're building
# both Android variants locally one after another, rewrite .env in between
# builds. See the android:*:build scripts in package.json and
# STEP12-APP-UPDATE-SETUP.md for exactly how each one is invoked. Never
# commit a real .env file — only this .example stays in git.

# ---------------------------------------------------------------------
# Cloud (all 3 shells need the same values — one shared Supabase project)
# ---------------------------------------------------------------------
VITE_SUPABASE_URL=https://vjimgnmbgghtsfafamye.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------
# Which of the 3 native shells this build is (Step 1.5-1.8 + Step 12)
# ---------------------------------------------------------------------
# "full"  -> Windows desktop app (default if unset) — both Owner + Staff
#            tiles at login, matches today's behaviour.
# "staff" -> dedicated Staff Android app — skips straight to Staff ID login.
# "owner" -> dedicated Owner Android app — skips straight to Owner login,
#            full Windows-equivalent access (Step 1.8).
VITE_APP_VARIANT=full

# ---------------------------------------------------------------------
# Step 12 — App Update & OTA Push System
# ---------------------------------------------------------------------
# Which app_versions.platform row this running build checks itself
# against (see src/services/appVersion.ts's detectRunningPlatform()).
# Must be one of: windows | staff-android | owner-android
VITE_APP_PLATFORM=windows

# The version/build THIS install currently is — compared against whatever
# the Owner has marked "live" in the App Versions panel. Bump these (and
# keep VITE_APP_VERSION in sync with src-tauri/tauri.conf.json's top-level
# "version" for the Windows build specifically — the Tauri Updater plugin
# does its own separate comparison against that field) every time you cut
# a release, THEN publish the built installer/APK with the same numbers
# from the Owner app's "App Versions" panel.
VITE_APP_VERSION=1.0.0
VITE_APP_BUILD=1
