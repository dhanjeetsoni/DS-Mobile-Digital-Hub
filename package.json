{
  "name": "ds-mobile-digital-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test:static": "node scripts/static-audit.mjs",
    "test": "vitest run",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "android:init": "tauri android init",
    "android:staff:dev": "tauri android dev --config src-tauri/tauri.staff-android.conf.json",
    "android:staff:build": "tauri android build --config src-tauri/tauri.staff-android.conf.json",
    "android:owner:dev": "tauri android dev --config src-tauri/tauri.owner-android.conf.json",
    "android:owner:build": "tauri android build --config src-tauri/tauri.owner-android.conf.json",
    "audit:hardening": "npm run typecheck && npm run test:static",
    "build:production": "npm run audit:hardening && npm run build"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.57.0",
    "@tauri-apps/plugin-updater": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "@zxing/browser": "^0.1.5",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sql.js": "^1.13.0",
    "tailwind-merge": "^2.6.0",
    "vite": "^6.2.3",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/sql.js": "^1.4.9",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^2.1.8"
  },
  "description": "Production-ready inventory, POS, warranty and shop management system"
}
